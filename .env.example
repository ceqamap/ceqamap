# Copy to .env for local runs. Never commit .env.

# Required by the pipeline: shown in the User-Agent sent to CEQAnet.
CEQANET_CONTACT=you@example.com

# Leave the R2 values empty to use local storage in ./.data instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Web: where published data lives. Leave empty in development to use ./.data.
VITE_DATA_URL=
