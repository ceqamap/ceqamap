// Cloudflare Workers static-assets config for the website.
// The site is fully static; no Worker script runs. Data is served separately from R2.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ceqamap",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web/dist",
    // Unknown paths fall back to index.html (shared links like /?p=... always work).
    "not_found_handling": "single-page-application",
  },
  // Production: our own domain only. Deploy creates the DNS records and certificates.
  "workers_dev": false,
  "routes": [
    { "pattern": "ceqamap.org", "custom_domain": true },
    { "pattern": "www.ceqamap.org", "custom_domain": true },
  ],
  "env": {
    // Pull requests deploy here for review before merging (`wrangler deploy --env preview`).
    // Worker name: ceqamap-preview.
    "preview": {
      "assets": {
        "directory": "./web/dist",
        "not_found_handling": "single-page-application",
      },
      "workers_dev": false,
      "routes": [{ "pattern": "preview.ceqamap.org", "custom_domain": true }],
    },
  },
}
